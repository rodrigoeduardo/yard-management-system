NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Bypasses RLS. Never used by the app's request path (lib/supabase/server.ts
# uses the publishable key above) — reserved for one-off admin/migration tooling.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Use the "Shared Pooler" connection string (Database settings > Connection
# string), not the direct host — the direct host is IPv6-only and unreachable
# from networks/sandboxes without IPv6 routing.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Auth test user (#13) — must exist in the Supabase project's auth users
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=changeme

# Register invite code
REGISTER_INVITE_CODE=XXXXXX
# Viewer invite code — registers a read-only account instead of an operator.
# Optional: unset means the viewer signup path does not exist at all (only
# REGISTER_INVITE_CODE is accepted). Must differ from REGISTER_INVITE_CODE.
VIEWER_INVITE_CODE=XXXXXX

# Item weight correction (issue #334) — off by default. When set to "true",
# gates operator correction of an in-stock item's weight; the load's
# Remaining Weight is recomputed as the exact sum of in-stock item weights
# (docs/specs/business-rules.md). Read server-side only
# (lib/inventory/feature-flags.ts) and enabled only by the exact string
# "true" — any other value, including unset, keeps it off.
FEATURE_ITEM_WEIGHT_EDIT=false

# Load editing (issue #352) — off by default. When set to "true", gates
# operator correction of a load's fields (Ordem de Transporte, Motorista,
# NF Date, Entry Date, NF Weight — always; Nota Fiscal and Material only
# while the load has no removed items) from the Estoque load-detail modal.
# Item Count and Peso Restante stay derived and are never accepted as input
# (docs/specs/business-rules.md). Read server-side only
# (lib/inventory/feature-flags.ts) and enabled only by the exact string
# "true" — any other value, including unset, keeps it off.
FEATURE_LOAD_EDIT=false

# Removal cancellation (issue #310) — off by default. When set to "true",
# gates reversing a removal in one transaction, e.g. when the wrong items
# were scanned or the customer's order was cancelled after the truck left
# (docs/specs/business-rules.md). Read server-side only
# (lib/removals/feature-flags.ts) and enabled only by the exact string
# "true" — any other value, including unset, keeps it off.
FEATURE_REMOVAL_CANCEL=false

# Demo mode (ADR 0002) — off by default. When set to "true", every visitor
# is transparently signed in as the seeded demo user below; /login and
# /register redirect into the app instead of showing auth UI. Leave unset
# for client-fork / normal authenticated deployments.
DEMO_MODE=false
# Must be a real Supabase Auth user in the project (production provisioning
# is a deploy-time human step — see docs/adr/0002-demo-mode-flag.md).
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=changeme
# CTA URL shown by the demo banner ("Fale conosco"), e.g. the landing page's
# contact section (issue #252 — the landing page itself comes later).
# Optional: unset renders the banner without a link, never a broken anchor.
DEMO_CONTACT_URL=https://example.com/contact
